# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# .env.local está no .gitignore — nunca versione as chaves.

# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole-a-anon-key-aqui"

# Chave secreta. Usada só no servidor (webhooks, freio do login, log de
# acesso, gestão de usuários, campanhas). Ignora RLS — nunca exponha em
# componente de cliente.
SUPABASE_SERVICE_ROLE_KEY="cole-a-service-role-key-aqui"

# WhatsApp Cloud API (Meta) — canal direto. Sem META_WHATSAPP_TOKEN o envio
# falha com aviso na tela; o recebimento depende só do webhook.
META_APP_SECRET=""
META_WHATSAPP_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN="crie-uma-frase-aleatoria-e-repita-no-painel-da-meta"
# Painel Meta > WhatsApp > API Setup
META_PHONE_NUMBER_ID=""
META_WABA_ID=""

# Lead Ads do Facebook: token da página com leads_retrieval (sem ele o
# formulário do anúncio fica registrado em webhook_events, sem virar contato).
META_PAGE_TOKEN=""

# Protege /api/cron/campanhas (Vercel > Settings > Environment Variables).
# Opcional: as campanhas já andam pelo batimento do layout enquanto alguém
# usa o sistema. A rota só serve a um cron externo chamando com
# "Authorization: Bearer <CRON_SECRET>"; sem a variável, ela fica fechada.
CRON_SECRET=""

# IA do chat (resumo e sugestão de resposta). Sem a chave, os botões de IA
# avisam que o recurso não está configurado — o resto do chat funciona normal.
ANTHROPIC_API_KEY=""

# Direct do Instagram.
# Token de usuário do Instagram com instagram_business_manage_messages.
INSTAGRAM_TOKEN=
# ID da conta profissional do Instagram (o perfil do Fabricio).
INSTAGRAM_ACCOUNT_ID=
# Só preencha se o app do Instagram for OUTRO (conta em Business Manager
# diferente da do WhatsApp). Em branco, usa os do app da Meta acima.
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Código de acesso por e-mail (aparelho novo e "Esqueci a senha"). Passo a
# passo do Resend em docs/SETUP.md.
# Segredo que assina os cookies do aparelho lembrado e do código pendente.
# 32 caracteres ou mais. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o valor faz todo aparelho pedir o código de novo.
CODIGO_LOGIN_SEGREDO=""
# Resend > API Keys, com permissão só de envio. Fora de produção, sem a
# chave, o e-mail não sai e o código aparece no terminal do servidor.
RESEND_API_KEY=""
# Remetente num domínio verificado no Resend.
EMAIL_REMETENTE="Zeve Atendimento <acesso@zeve.com.br>"

# SÓ na máquina de desenvolvimento ligada no banco de produção: "1" desliga o
# batimento das campanhas no layout. Sem isto, abrir uma página local
# dispararia envios reais (ou gravaria falha, com o envio desligado).
# Nunca defina na Vercel.
# MOTORES_DESLIGADOS=1

# SÓ na máquina de desenvolvimento, e só para o "npm run start" local: "1"
# libera a página /autenticador-local, que sobe a sessão para o nível do app
# autenticador enquanto o banco ainda exige (docs/SETUP.md). No "npm run dev"
# ela já existe sem isto. Nunca defina na Vercel.
# AUTENTICADOR_LOCAL=1
