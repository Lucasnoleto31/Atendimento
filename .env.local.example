# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# .env.local está no .gitignore — nunca versione as chaves.

# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole-a-anon-key-aqui"

# Chave secreta. Usada só no servidor (rota do webhook e importações).
# Ignora RLS — nunca exponha em componente de cliente.
SUPABASE_SERVICE_ROLE_KEY="cole-a-service-role-key-aqui"

# WhatsApp Cloud API (Meta) — canal direto. Com META_WHATSAPP_TOKEN
# preenchido, todo envio sai pela Meta e o Chatwoot deixa de ser usado.
META_APP_SECRET=""
META_WHATSAPP_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN="crie-uma-frase-aleatoria-e-repita-no-painel-da-meta"
# Painel Meta > WhatsApp > API Setup
META_PHONE_NUMBER_ID=""
META_WABA_ID=""

# Protege /api/cron/cadencia (Vercel > Settings > Environment Variables).
CRON_SECRET=""

# IA do chat (resumo e sugestão de resposta). Sem a chave, os botões de IA
# avisam que o recurso não está configurado — o resto do CRM funciona normal.
ANTHROPIC_API_KEY=""

# Sincronização diária da corretora (bucket S3 da Genial com os arquivos de
# clientes e lotes). Sem estas variáveis o recurso fica INATIVO e mudo —
# nada quebra, a importação só não roda.
GENIAL_S3_ENDPOINT=""
GENIAL_S3_REGION=""
GENIAL_S3_BUCKET=""
GENIAL_S3_ACCESS_KEY_ID=""
GENIAL_S3_SECRET_ACCESS_KEY=""
# Prefixo (pasta) dentro do bucket onde os arquivos chegam; vazio = raiz.
GENIAL_S3_PREFIX=""

# Chatwoot — o número oficial hoje vive lá; o CRM conversa com ele pela API.
# Frase secreta que protege o webhook: use-a na URL configurada no Chatwoot.

# Direct do Instagram.
# Token de usuário do Instagram com instagram_business_manage_messages.
INSTAGRAM_TOKEN=
# ID da conta profissional do Instagram (o perfil do Fabricio).
INSTAGRAM_ACCOUNT_ID=
# Só preencha se o app do Instagram for OUTRO (conta em Business Manager
# diferente da do WhatsApp). Em branco, usa os do app da Meta acima.
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Segundo fator no middleware (o banco tem o próprio interruptor em settings.exigir_2fa). "0" desliga.
# EXIGIR_2FA=1
